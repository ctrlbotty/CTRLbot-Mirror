{
  "name": "ctrlbot-mirror",
  "productName": "CTRLbot Mirror",
  "version": "0.1.0",
  "description": "A Windows utility for mirroring, controlling and capturing Android devices — built for training videos and device setup.",
  "author": {
    "name": "CTRLbot",
    "email": "natmutt@gmail.com"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/ctrlbotty/CTRLbot-Mirror",
  "type": "module",
  "main": "./out/main/index.mjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/fetch-scrcpy-server.mjs",
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:portable": "npm run build && electron-builder --win portable --publish never",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,yml,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "fetch:scrcpy": "node scripts/fetch-scrcpy-server.mjs --force",
    "clean": "node -e \"import('node:fs').then(fs=>['out','dist','node_modules/.vite'].forEach(d=>fs.rmSync(d,{recursive:true,force:true})))\""
  },
  "dependencies": {
    "@yume-chan/adb": "^2.6.2",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/adb-server-node-tcp": "^2.5.2",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/stream-extra": "^2.6.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3",
    "clsx": "^2.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lucide-react": "^1.27.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "zustand": "^5.0.14"
  }
}
